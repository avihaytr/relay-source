+                  : (SDL_FRect){17,45,SDL_max(1,w-98),SDL_max(1,h-62)};
+    const int tools[] = {FULL,CAMERA,ROTATE,MUTE,STOP};
+    for (int i=0;i<5;++i) {
+        float side=SDL_max(1.f,step-6);
+        l.buttons[tools[i]]=(SDL_FRect){l.tools.x+5+(wide?i*step:0),
+            l.tools.y+5+(wide?0:i*step),wide?side:44,wide?44:side};
+    }
+    return l;
+}
+
+static bool contains(SDL_FRect r,float x,float y) {
+    return x>=r.x && y>=r.y && x<r.x+r.w && y<r.y+r.h;
+}
+
+static int toolbar_button(struct sc_screen *s,float x,float y) {
+    struct relay_layout l=toolbar_layout(s);
+    for (int i=0;i<BUTTON_COUNT;++i)
+        if (contains(l.buttons[i],x,y)) return i;
+    return -1;
+}
+
+static SDL_HitTestResult SDLCALL
+toolbar_hit(SDL_Window *window,const SDL_Point *p,void *data) {
+    struct sc_screen *s=data;
+    int w,h; SDL_GetWindowSize(window,&w,&h);
+    if (p->x<4 && p->y<4) return SDL_HITTEST_RESIZE_TOPLEFT;
+    if (p->x>=w-4 && p->y>=h-4) return SDL_HITTEST_RESIZE_BOTTOMRIGHT;
+    if (p->x<4) return SDL_HITTEST_RESIZE_LEFT;
+    if (p->x>=w-4) return SDL_HITTEST_RESIZE_RIGHT;
+    if (p->y<2) return SDL_HITTEST_RESIZE_TOP;
+    if (p->y>=h-4) return SDL_HITTEST_RESIZE_BOTTOM;
+    return p->y<30 && toolbar_button(s,p->x,p->y)<0 ? SDL_HITTEST_DRAGGABLE : SDL_HITTEST_NORMAL;
+}
+
+#include "relay_chrome_png.h"
+
+static SDL_Texture *toolbar_texture(SDL_Renderer *r) {
+    SDL_IOStream *io=SDL_IOFromConstMem(relay_chrome_png,sizeof(relay_chrome_png));
+    SDL_Surface *surface=io ? SDL_LoadPNG_IO(io,true) : NULL;
+    if (!surface) return NULL;
+    SDL_Texture *texture=SDL_CreateTextureFromSurface(r,surface);
+    SDL_DestroySurface(surface);
+    if (texture) {
+        SDL_SetTextureScaleMode(texture,SDL_SCALEMODE_LINEAR);
+        SDL_SetTextureBlendMode(texture,SDL_BLENDMODE_BLEND);
+    }
+    return texture;
+}
+
+static void rounded_mask(struct sc_screen *s,SDL_FRect box,float radius,bool inverse) {
+    SDL_FRect source={inverse ? 70 : 0,0,65,65};
+    Uint8 red,green,blue,alpha;
+    SDL_GetRenderDrawColor(s->renderer,&red,&green,&blue,&alpha);
+    SDL_SetTextureColorMod(s->relay_chrome,red,green,blue);
+    float fit=SDL_min(radius,SDL_min(box.w,box.h)/2);
+    SDL_RenderTexture9Grid(s->renderer,s->relay_chrome,&source,32,32,32,32,fit/32,&box);
+}
+
+static void rounded(struct sc_screen *s,SDL_FRect box,float radius) {
+    rounded_mask(s,box,radius,false);
+}
+
+static void toolbar_draw(struct sc_screen *s) {
+    SDL_Renderer *r=s->renderer;
+    float scale=SDL_GetWindowPixelDensity(s->window);
+    SDL_SetRenderScale(r,scale,scale);
+    struct relay_layout l=toolbar_layout(s);
+    SDL_SetRenderDrawColor(r,248,250,254,255);
+    rounded(s,l.header,8);
+    SDL_SetRenderDrawColor(r,251,252,255,255);
+    rounded(s,l.tools,11);
+    SDL_SetRenderDrawColor(r,79,91,111,255);
+    bool saved=SDL_GetTicks()<s->relay_saved_until;
+    SDL_FRect label_src={0,saved?148:76,480,68};
+    SDL_FRect label_dst={20,6,120,17};
+    SDL_SetTextureColorMod(s->relay_chrome,79,91,111);
+    SDL_RenderTexture(r,s->relay_chrome,&label_src,&label_dst);
+    // Each group of four coordinates describes one icon stroke.
+    static const int strokes[][11][4] = {
+        {{-5,-7,5,-7},{5,-7,3,-4},{3,-4,3,0},{3,0,6,3},{6,3,-6,3},{-6,3,-3,0},{-3,0,-3,-4},{-3,-4,-5,-7},{0,3,0,9}},
+        {{-8,-3,-8,-7},{-8,-7,-3,-7},{3,-7,8,-7},{8,-7,8,-3},{8,3,8,7},{8,7,3,7},{-3,7,-8,7},{-8,7,-8,3}},
+        {{-9,-5,-3,-5},{-3,-5,-2,-7},{-2,-7,3,-7},{3,-7,4,-5},{4,-5,9,-5},{9,-5,9,7},{9,7,-9,7},{-9,7,-9,-5},{-3,0,0,-3},{0,-3,3,0},{3,0,0,3}},
+        {{-7,-7,7,-7},{7,-7,7,7},{7,7,-7,7},{-7,7,-7,-7}}
+        ,{{-6,-9,5,-9},{5,-9,5,9},{5,9,-6,9},{-6,9,-6,-9},{9,-4,9,6},{9,6,13,2},{9,6,6,2}},
+        {{-9,-3,-5,-3},{-5,-3,1,-8},{1,-8,1,8},{1,8,-5,3},{-5,3,-9,3},{-9,3,-9,-3},{5,-4,9,0},{9,0,5,4}},
+        {{-4,0,4,0}},{{-4,-4,4,4},{4,-4,-4,4}}
+    };
+    static const int count[] = {9,8,11,4,7,8,1,2};
+    SDL_WindowFlags flags = SDL_GetWindowFlags(s->window);
+    for (int i = 0; i < BUTTON_COUNT; ++i) {
+        SDL_FRect button=l.buttons[i];
+        float x=button.x+button.w/2, y=button.y+button.h/2;
+        if (s->relay_hover == i || (i == 0 && (flags & SDL_WINDOW_ALWAYS_ON_TOP))
+                || (i == MUTE && SDL_GetAtomicInt(&relay_muted)) || (i == 1 && (flags & SDL_WINDOW_FULLSCREEN))) {
+            SDL_FRect bg = button;
+            SDL_SetRenderDrawColor(r, 222, 235, 255, 255);
+            rounded(s,bg,6);
+        }
+        SDL_SetRenderDrawColor(r, i == 3 ? 211 : 52, i == 3 ? 70 : 113, i == 3 ? 88 : 246, 255);
+        for (int j = 0; j < count[i]; ++j) {
+            const int *p = strokes[i][j];
+            SDL_RenderLine(r,(x+p[0]),(y+p[1]),(x+p[2]),(y+p[3]));
+        }
+        if (i == 2)
+            SDL_RenderLine(r,(x+0),(y+3),(x-3),y);
+    }
+    SDL_SetRenderScale(r,1,1);
+}
+
+static void
+toolbar_save(struct sc_screen *s) {
+    float density = SDL_GetWindowPixelDensity(s->window);
+    SDL_Rect rect = {(int)(s->rect.x*density), (int)(s->rect.y*density),
+                     (int)(s->rect.w*density), (int)(s->rect.h*density)};
+    const char *dir = SDL_getenv("RELAY_CAPTURE_DIR");
+    SDL_Surface *surface = SDL_RenderReadPixels(s->renderer, &rect);
+    SDL_Time now;
+    char *path = NULL;
+    bool saved = surface && dir && SDL_GetCurrentTime(&now)
+        && SDL_asprintf(&path, "%s/Screenshot-%lld.png", dir, (long long)now) >= 0
+        && SDL_SavePNG(surface, path);
+    if (saved) s->relay_saved_until=SDL_GetTicks()+2500;
+    if (!saved)
+        SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_ERROR, "Relay", "Could not save the screenshot.", s->window);
+    SDL_free(path);
+    SDL_DestroySurface(surface);
+}
+
+static void
+toolbar_activate(struct sc_screen *s, int index) {
+    switch (index) {
+        case 0:
+            if (!strcmp(SDL_GetCurrentVideoDriver(), "wayland")) {
+                if (!relay_can_restart) {
+                    SDL_ShowWindowSystemMenu(s->window, 16, BAR_HEIGHT);
+                    break;
+                }
+                const SDL_MessageBoxButtonData buttons[]={{SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT,0,"Cancel"},
+                    {SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT,1,"Switch and pin"}};
+                SDL_MessageBoxData dialog={SDL_MESSAGEBOX_INFORMATION,s->window,"Pin mirror",
+                    "Restart this viewer with XWayland to keep it above other windows?",2,buttons,NULL};
+                int choice=0;
+                if (SDL_ShowMessageBox(&dialog,&choice) && choice==1) {
+                    relay_restart=true;
+                    SDL_Event quit={.type=SDL_EVENT_QUIT};
+                    SDL_PushEvent(&quit);
+                }
+            } else {
+                bool pinned = SDL_GetWindowFlags(s->window) & SDL_WINDOW_ALWAYS_ON_TOP;
+                if (!SDL_SetWindowAlwaysOnTop(s->window, !pinned))
+                    SDL_ShowSimpleMessageBox(SDL_MESSAGEBOX_INFORMATION, "Pin mirror", SDL_GetError(), s->window);
+            }
+            break;
+        case 1: sc_screen_toggle_fullscreen(s); break;
+        case 2: s->relay_capture = true; break;
+        case ROTATE: sc_screen_set_orientation(s,sc_orientation_apply(s->orientation,SC_ORIENTATION_90)); break;
+        case MUTE: SDL_SetAtomicInt(&relay_muted,!SDL_GetAtomicInt(&relay_muted)); break;
+        case MINIMIZE: SDL_MinimizeWindow(s->window); break;
+        case CLOSE:
+        case 3: {
+            SDL_Event quit = {.type = SDL_EVENT_QUIT};
+            SDL_PushEvent(&quit);
+            break;
+        }
+    }
+}
